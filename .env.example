# =====================================================================================
# RAG-Ops environment. Copy to `.env` and fill in. `.env` is gitignored - never commit it.
# Step-by-step instructions for every value: docs/SETUP_CREDENTIALS.md
# Verify everything with:  ragops doctor
# =====================================================================================

# local | ci | prod
RAGOPS_ENV=local
LOG_LEVEL=INFO
# true = run with zero credentials (hash embeddings, extractive answers, lexical rerank).
# Great for exploring the UI first. Eval scores are meaningless in offline mode.
RAGOPS_OFFLINE=false

# ---- GCP / Vertex AI (Gemini: PDF parsing, reasoning, eval judge, synthetic data) ----
# Service-account JSON key with role "Vertex AI User" (roles/aiplatform.user).
# Put the file at secrets/gcp-vertex-key.json (the secrets/ folder is gitignored).
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-vertex-key.json
# Gemini 3.x models are served from the `global` location.
VERTEX_LOCATION=global
# Embedding models are regional.
VERTEX_EMBEDDING_LOCATION=us-central1

# ---- AWS / Bedrock (Claude synthesis + Bedrock Guardrails) ---------------------------
# IAM user/role with bedrock:InvokeModel, bedrock:InvokeModelWithResponseStream,
# bedrock:ApplyGuardrail (+ bedrock:CreateGuardrail* once for `ragops create-guardrail`).
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary (STS) credentials:
AWS_SESSION_TOKEN=
# Alternative to keys: a named profile from ~/.aws/credentials
AWS_PROFILE=
# Filled after running `ragops create-guardrail`:
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
# Email domains quoted by your documents (support@, security@ ...) that are content, not
# personal data, so the local guard does not anonymise them. Comma-separated.
GUARDRAIL_ALLOWED_EMAIL_DOMAINS=lumenledger.example,aurora-energy.example

# ---- Cohere (reranker) ---------------------------------------------------------------
# https://dashboard.cohere.com/api-keys (a free trial key works)
COHERE_API_KEY=

# ---- Optional model overrides (defaults live in config/models.yaml) ------------------
# Current setup is GCP only: Gemini 3.8 Flash runs every route (answers, PDF parsing,
# reasoning, synthetic data, judging). Leave the AWS section above empty.
# VERTEX_FLASH_MODEL=vertex_ai/gemini-3.8-flash
# EMBEDDING_MODEL=vertex_ai/gemini-embedding-001
# Parked (defined, not used by any route):
# VERTEX_PRO_MODEL=vertex_ai/gemini-3.1-pro-preview
# VERTEX_CLAUDE_HAIKU_MODEL=vertex_ai/claude-haiku-5-5   (needs a paid billing account)
# BEDROCK_SONNET_MODEL=bedrock/apac.anthropic.claude-sonnet-5-5
# BEDROCK_HAIKU_MODEL=bedrock/apac.anthropic.claude-haiku-5-5
# RERANK_MODEL=cohere/rerank-v3.5
# PDF_PARSER=gemini

# ---- Qdrant ---------------------------------------------------------------------------
# Empty = embedded on-disk Qdrant (single process, zero setup).
# With docker compose: http://localhost:6333   |  Qdrant Cloud: https://<cluster>.cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=ragops

# ---- Background tasks -------------------------------------------------------------------
# inline = in the API process (default) | celery = Redis + Celery workers (docker compose)
TASK_QUEUE=inline
REDIS_URL=redis://localhost:6379/0

# ---- Observability (OpenTelemetry / OpenInference) ----------------------------------------
# Empty = tracing off.
# Phoenix (docker compose / `phoenix serve`):  http://localhost:6006/v1/traces
# Phoenix Cloud: https://app.phoenix.arize.com/s/<space>/v1/traces  + header api_key=<key>
# Langfuse:      https://cloud.langfuse.com/api/public/otel/v1/traces + header Authorization=Basic <base64 pk:sk>
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Comma-separated key=value pairs
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=ragops

# ---- API ---------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
# Optional: require header X-Admin-Key on write endpoints (upload/delete/eval runs)
ADMIN_API_KEY=
# Maximum upload size (long PDFs are parsed in page batches, so large files are fine)
MAX_UPLOAD_MB=100
# Ingest the demo corpus automatically when the index is empty (used by docker compose)
RAGOPS_AUTO_INGEST=false
